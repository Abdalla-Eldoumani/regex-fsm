{
  "name": "regex-fsm",
  "private": false,
  "version": "0.0.0",
  "description": "Educational tool for visualizing regular expressions, NFAs, and DFAs",
  "keywords": [
    "regex",
    "automata",
    "nfa",
    "dfa",
    "visualization",
    "education"
  ],
  "author": "Abdalla ElDoumani, Ibrahim Ahmed",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cytoscape": "3.34.0",
    "cytoscape-edgehandles": "4.0.1",
    "lz-string": "1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/cytoscape": "3.31.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/ui": "4.1.8",
    "eslint": "10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "4.8.0",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
